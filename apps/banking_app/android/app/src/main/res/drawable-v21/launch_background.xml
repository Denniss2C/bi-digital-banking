<?xml version="1.0" encoding="utf-8"?>
<!-- Same as drawable/launch_background.xml: Android 5+ uses this one. It is
     kept, not deleted, because deleting it breaks Gradle's incremental
     resource merge in existing builds ("launch_background not found"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/nexo_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
