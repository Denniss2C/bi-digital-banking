<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: navy with the Nexo mark in the center. The
     mark (launch_mark.png) comes from tool/brand_assets_test.dart. Keep it
     equal to drawable-v21/launch_background.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/nexo_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
