<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (Dark Mode on) draws its own splash: the app icon on
         windowSplashScreenBackground. Same navy as the splash before 12. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/nexo_navy</item>
    </style>
</resources>
